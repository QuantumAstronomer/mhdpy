## The tests of the unit system, one module per group of requirements, with the reference values they share.
py.install_sources(
  '__init__.py',
  'reference.py',
  'test_definition.py',
  'test_conversions.py',
  'test_magnetic_field.py',
  'test_temperature.py',
  'test_constants.py',
  'test_records.py',
  'test_dimensionless.py',
  'test_dependencies.py',
  subdir: 'mhdpy/foundation/tests/units',
)
