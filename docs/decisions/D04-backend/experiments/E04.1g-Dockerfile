# Linux environment of experiment E04.1: the official uv image with Python 3.14, plus a C compiler with OpenMP (gcc,
# with libgomp) for the C and Cython kernels. Built and used by E04.1h-run.py.
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
